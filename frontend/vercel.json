{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_RAILWAY_URL/api/:path*"
    },
    {
      "source": "/((?!assets|sw\\.js|workbox-|manifest\\.webmanifest|registerSW\\.js|favicon\\.ico|apple-touch-icon\\.png|mask-icon\\.svg|pwa-).+)",
      "destination": "/index.html"
    }
  ]
}
