# ===========================================
# Dottò - Environment Variables
# ===========================================


# -----------------------------
# Supabase (legacy - da rimuovere dopo migrazione)
# -----------------------------
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx...
SUPABASE_SECRET_KEY=sb_secret_xxxxx...

# Database connection string (PostgreSQL)
# Formato: postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# -----------------------------
# JWT Auth
# -----------------------------
# Genera con: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# -----------------------------
# Twilio (SMS)
# -----------------------------
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------
# Brevo (Email)
# -----------------------------
# API Key da: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxx...
# Email del mittente. Per test SENZA dominio verificato:
# 1. In Brevo: Settings → Senders → Aggiungi mittente (es. tua email personale)
# 2. Verifica il mittente con il codice OTP che Brevo invia a quell'email (niente DNS)
# 3. Usa qui la stessa email. Le mail possono finire in spam ma l'invio funziona.
BREVO_SENDER_EMAIL=noreply@dotto.bike
# Nome del mittente (opzionale)
BREVO_SENDER_NAME=Dottò

# -----------------------------
# App Settings
# -----------------------------
# URL pubblico dell'app (per generare link QR)
APP_URL=https://dotto.bike
# Ambiente: development | production
ENVIRONMENT=development
# Debug mode
DEBUG=true

# -----------------------------
# CORS Origins (separati da virgola)
# -----------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


