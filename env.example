# ===========================================
# Dottò - Environment Variables
# ===========================================
# Copia questo file in .env e compila con i tuoi valori
# NON committare mai il file .env!

# -----------------------------
# Supabase
# -----------------------------
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database connection string (PostgreSQL)
# Formato: postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# -----------------------------
# JWT Auth
# -----------------------------
# Genera con: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# -----------------------------
# Twilio (SMS)
# -----------------------------
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------
# App Settings
# -----------------------------
# URL pubblico dell'app (per generare link QR)
APP_URL=https://dotto.bike
# Ambiente: development | production
ENVIRONMENT=development
# Debug mode
DEBUG=true

# -----------------------------
# CORS Origins (separati da virgola)
# -----------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


